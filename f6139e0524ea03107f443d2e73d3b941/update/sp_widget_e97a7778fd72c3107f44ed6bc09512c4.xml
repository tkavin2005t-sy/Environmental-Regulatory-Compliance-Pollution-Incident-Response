        <script><![CDATA[(function() {

    var TABLE = 'x_snc_environmen_0_inspection';

    data.inspections = [];
    data.activeInspections = 0;
    data.completedInspections = 0;
    data.pendingInspections = 0;

    var gr = new GlideRecord(TABLE);
    gr.orderByDesc('sys_created_on');
    gr.setLimit(100);
    gr.query();

    while (gr.next()) {

        var status = gr.getDisplayValue('inspection_status');

        // Status counts
        if (
            status == 'Assigned' ||
            status == 'In Progress' ||
            status == 'Work in Progress'
        ) {
            data.activeInspections++;
        }
        else if (
            status == 'Completed' ||
            status == 'Closed Complete' ||
            status == 'Complete' ||
            status == 'Closed'
        ) {
            data.completedInspections++;
        }
        else {
            data.pendingInspections++;
        }

        // Inspection record
        data.inspections.push({
            sys_id: gr.getUniqueValue(),

            number: gr.getDisplayValue('inspection_number'),

            complaint: gr.getDisplayValue('complaint'),

            inspection_date: gr.getDisplayValue('inspection_date'),

            inspection_findings: gr.getDisplayValue('inspection_findings'),

            inspection_outcome: gr.getDisplayValue('inspection_outcome'),

            inspection_status: gr.getDisplayValue('inspection_status'),

            inspector_remarks: gr.getDisplayValue('inspector_remarks'),

            recommended_action: gr.getDisplayValue('recommended_action'),

            assigned_inspector: gr.getDisplayValue('assigned_inspector')
        });
    }

})();]]></script>
